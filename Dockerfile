# syntax=docker/dockerfile:1

FROM node:20-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_APP_ENV=production
ARG NEXT_PUBLIC_API_DEV
ARG NEXT_PUBLIC_API_PROD
ARG NEXT_PUBLIC_MTO_API_BASE
ARG NEXT_PUBLIC_KWIKPASS_MERCHANT_ID
ARG NEXT_PUBLIC_KWIKPASS_ENVIRONMENT
ARG NEXT_PUBLIC_KP_BASE
ARG NEXT_PUBLIC_KWIKPASS_SHOP_DOMAIN
ARG NEXT_PUBLIC_OMS_API_URL
ARG NEXT_PUBLIC_GOKWIK_STORE_ID=
ARG NEXT_PUBLIC_GOKWIK_FB_PIXEL=
ARG NEXT_PUBLIC_ANALYTICS_META_PIXEL_ID=
ARG NEXT_PUBLIC_ANALYTICS_GA4_MEASUREMENT_ID=
ARG NEXT_PUBLIC_ANALYTICS_GOOGLE_ADS_CONVERSION_ID=
ARG NEXT_PUBLIC_ANALYTICS_GOOGLE_ADS_PURCHASE_SEND_TO=
ARG NEXT_PUBLIC_ANALYTICS_SIMPROSYS_GTM_CONTAINER_ID=
ARG NEXT_PUBLIC_ANALYTICS_PINTEREST_TAG_ID=
ARG NEXT_PUBLIC_ANALYTICS_SPOTIFY_PIXEL_ID=
ARG NEXT_PUBLIC_ANALYTICS_ADMITAD_CAMPAIGN_CODE=
ARG NEXT_PUBLIC_ANALYTICS_MIXPANEL_TOKEN=
ARG NEXT_PUBLIC_ANALYTICS_MIXPANEL_API_HOST=
ARG NEXT_PUBLIC_ANALYTICS_CLARITY_PROJECT_ID=
ARG NEXT_PUBLIC_ANALYTICS_WEBENGAGE_LICENSE_CODE=
ARG NEXT_PUBLIC_ANALYTICS_WEBENGAGE_DATA_CENTER=
ARG NEXT_PUBLIC_CAREERS_GENERAL_SCRIPT_URL
ARG NEXT_PUBLIC_CAREERS_JOB_SCRIPT_URL

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV \
    NEXT_PUBLIC_API_DEV=$NEXT_PUBLIC_API_DEV \
    NEXT_PUBLIC_API_PROD=$NEXT_PUBLIC_API_PROD \
    NEXT_PUBLIC_MTO_API_BASE=$NEXT_PUBLIC_MTO_API_BASE \
    NEXT_PUBLIC_KWIKPASS_MERCHANT_ID=$NEXT_PUBLIC_KWIKPASS_MERCHANT_ID \
    NEXT_PUBLIC_KWIKPASS_ENVIRONMENT=$NEXT_PUBLIC_KWIKPASS_ENVIRONMENT \
    NEXT_PUBLIC_KP_BASE=$NEXT_PUBLIC_KP_BASE \
    NEXT_PUBLIC_KWIKPASS_SHOP_DOMAIN=$NEXT_PUBLIC_KWIKPASS_SHOP_DOMAIN \
    NEXT_PUBLIC_OMS_API_URL=$NEXT_PUBLIC_OMS_API_URL \
    NEXT_PUBLIC_GOKWIK_STORE_ID=$NEXT_PUBLIC_GOKWIK_STORE_ID \
    NEXT_PUBLIC_GOKWIK_FB_PIXEL=$NEXT_PUBLIC_GOKWIK_FB_PIXEL \
    NEXT_PUBLIC_ANALYTICS_META_PIXEL_ID=$NEXT_PUBLIC_ANALYTICS_META_PIXEL_ID \
    NEXT_PUBLIC_ANALYTICS_GA4_MEASUREMENT_ID=$NEXT_PUBLIC_ANALYTICS_GA4_MEASUREMENT_ID \
    NEXT_PUBLIC_ANALYTICS_GOOGLE_ADS_CONVERSION_ID=$NEXT_PUBLIC_ANALYTICS_GOOGLE_ADS_CONVERSION_ID \
    NEXT_PUBLIC_ANALYTICS_GOOGLE_ADS_PURCHASE_SEND_TO=$NEXT_PUBLIC_ANALYTICS_GOOGLE_ADS_PURCHASE_SEND_TO \
    NEXT_PUBLIC_ANALYTICS_SIMPROSYS_GTM_CONTAINER_ID=$NEXT_PUBLIC_ANALYTICS_SIMPROSYS_GTM_CONTAINER_ID \
    NEXT_PUBLIC_ANALYTICS_PINTEREST_TAG_ID=$NEXT_PUBLIC_ANALYTICS_PINTEREST_TAG_ID \
    NEXT_PUBLIC_ANALYTICS_SPOTIFY_PIXEL_ID=$NEXT_PUBLIC_ANALYTICS_SPOTIFY_PIXEL_ID \
    NEXT_PUBLIC_ANALYTICS_ADMITAD_CAMPAIGN_CODE=$NEXT_PUBLIC_ANALYTICS_ADMITAD_CAMPAIGN_CODE \
    NEXT_PUBLIC_ANALYTICS_MIXPANEL_TOKEN=$NEXT_PUBLIC_ANALYTICS_MIXPANEL_TOKEN \
    NEXT_PUBLIC_ANALYTICS_MIXPANEL_API_HOST=$NEXT_PUBLIC_ANALYTICS_MIXPANEL_API_HOST \
    NEXT_PUBLIC_ANALYTICS_CLARITY_PROJECT_ID=$NEXT_PUBLIC_ANALYTICS_CLARITY_PROJECT_ID \
    NEXT_PUBLIC_ANALYTICS_WEBENGAGE_LICENSE_CODE=$NEXT_PUBLIC_ANALYTICS_WEBENGAGE_LICENSE_CODE \
    NEXT_PUBLIC_ANALYTICS_WEBENGAGE_DATA_CENTER=$NEXT_PUBLIC_ANALYTICS_WEBENGAGE_DATA_CENTER \
    NEXT_PUBLIC_CAREERS_GENERAL_SCRIPT_URL=$NEXT_PUBLIC_CAREERS_GENERAL_SCRIPT_URL \
    NEXT_PUBLIC_CAREERS_JOB_SCRIPT_URL=$NEXT_PUBLIC_CAREERS_JOB_SCRIPT_URL

RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000

CMD ["node", "server.js"]
